# Vite publica solo variables con prefijo VITE_ en el bundle.
# GitHub Pages del repositorio:
VITE_BASE_PATH=/DrunagorTurnTrackerV2/
# Dominio propio o hosting en la raíz:
# VITE_BASE_PATH=/

# true solo si se necesita depurar un build de producción.
VITE_SOURCEMAP=false

# Versión visible en los guardados y en la interfaz.
VITE_APP_VERSION=1.0.0

# Reservada para una futura API; actualmente la app no realiza llamadas HTTP.
# VITE_API_BASE_URL=
